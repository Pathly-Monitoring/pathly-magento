{
    "name": "pathly/module-monitoring",
    "description": "Pathly for Magento: Ping of the shop, Flow of the checkout prepared by Lumi, replay after each update, dashboard panel and availability badge.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "OSL-3.0",
    "keywords": [
        "magento",
        "magento2",
        "adobe commerce",
        "monitoring",
        "uptime",
        "checkout",
        "synthetic monitoring",
        "pathly"
    ],
    "homepage": "https://pathlyhq.com",
    "support": {
        "email": "simon@pathlyhq.com",
        "docs": "https://github.com/Pathly-Monitoring/pathly-magento#readme",
        "source": "https://github.com/Pathly-Monitoring/pathly-magento"
    },
    "authors": [
        {
            "name": "Pathly",
            "homepage": "https://pathlyhq.com"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.6",
        "magento/module-backend": "^102.0.6",
        "magento/module-config": "^101.2.6",
        "magento/module-cron": "^100.4.6",
        "magento/module-store": "^101.1.6",
        "magento/module-widget": "^101.2.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Pathly\\Monitoring\\": ""
        }
    },
    "archive": {
        "exclude": [
            "/Test",
            "/dev",
            "/publication",
            "/.github",
            "/vendor",
            "/build",
            "/phpunit.xml.dist",
            "/phpcs.xml.dist",
            "/.release-please-manifest.json",
            "/release-please-config.json",
            "/.gitattributes",
            "/.gitignore"
        ]
    }
}
