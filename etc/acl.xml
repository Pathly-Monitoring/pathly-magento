<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::dashboard">
                    <resource id="Pathly_Monitoring::dashboard" title="Pathly panel" translate="title"
                              sortOrder="100"/>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Pathly_Monitoring::config" title="Pathly" translate="title" sortOrder="100">
                                <resource id="Pathly_Monitoring::lumi" title="Prepare a Flow with Lumi"
                                          translate="title" sortOrder="10"/>
                            </resource>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
