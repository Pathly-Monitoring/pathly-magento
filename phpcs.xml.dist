<ruleset name="Pathly_Monitoring">
    <description>Magento Coding Standard, as checked by the Adobe Commerce Marketplace.</description>
    <rule ref="Magento2"/>
    <arg name="extensions" value="php,phtml,xml"/>
    <arg value="sp"/>
    <file>.</file>
    <exclude-pattern>*/dev/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/publication/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/Test/*</exclude-pattern>
</ruleset>
